# Local Docker database. Use the provider's connection string with TLS in production.
DATABASE_URL=postgresql://relay:relay_local_only@127.0.0.1:5432/relay
# Canonical browser origin; do not include a trailing path.
APP_URL=http://localhost:3000
# Comma-separated exact HTTPS hostnames. Empty permits only the built-in demo targets.
JOB_ALLOWED_HOSTS=
# Optional. Each worker must have a unique ID; omit to generate one per process.
# WORKER_ID=worker-local-1
# Optional native PostgreSQL integration tests (isolated schema, created and removed).
# TEST_DATABASE_URL=postgresql://relay:relay_local_only@127.0.0.1:5432/relay
