{
  "name": "relay-job-automation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "worker": "node --env-file-if-exists=.env --import tsx worker/worker.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "test:integration": "vitest run tests/postgres.test.ts",
    "dev:db": "node --import tsx scripts/dev-db.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:smoke": "node --import tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.24",
    "pg": "^8.16.3",
    "react": "^19.1.7",
    "react-dom": "^19.1.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.10.0"
  }
}
